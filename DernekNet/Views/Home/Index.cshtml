@model IEnumerable<DernekNet.Models.Dernek>
@using System.Linq
@{
    Layout = null;
    ViewData["Title"] = "DERNEKNET | Dernek Rehberi";
    var dernekler = (Model ?? Enumerable.Empty<DernekNet.Models.Dernek>())
        .Where(d => d.AktifMi)
        .OrderBy(d => d.DernekAdi)
        .ToList();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="DERNEKNET dernek rehberi: Dernekleri keşfedin, faaliyetlerini inceleyin ve iletişim kurun." />
    <title>DERNEKNET | Dernek Rehberi</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=3" />
    <style>
        :root {
            --navy: #10253a;
            --navy2: #19354d;
            --teal: #087f85;
            --gold: #e4b66b;
            --ink: #192e40;
            --muted: #657787;
            --line: #e1e8ee;
            --bg: #f4f6f9
        }

        * {
            box-sizing: border-box
        }

        html {
            scroll-behavior: smooth
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--ink);
            font-family: 'Segoe UI',Arial,sans-serif
        }

        a {
            color: inherit
        }

        .shell {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px
        }

        .topbar {
            background: var(--navy);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 40;
            box-shadow: 0 3px 15px #0b213222
        }

        .nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            min-height: 76px
        }

        .logo {
            text-decoration: none;
            color: #fff;
            font-size: 25px;
            font-weight: 900;
            letter-spacing: -1px;
            white-space: nowrap
        }

            .logo span {
                color: var(--gold)
            }

        .navlinks {
            display: flex;
            align-items: center;
            gap: 22px
        }

            .navlinks > a, .drop-toggle {
                font: 650 13px 'Segoe UI',Arial,sans-serif;
                color: #e5edf4;
                text-decoration: none;
                border: 0;
                background: none;
                cursor: pointer
            }

                .navlinks > a:hover, .drop-toggle:hover {
                    color: var(--gold)
                }

            .navlinks .login {
                padding: 11px 16px;
                border-radius: 9px;
                background: var(--teal);
                color: white
            }

                .navlinks .login:hover {
                    background: #0b9aa1;
                    color: #fff
                }

            .navlinks .whatsapp-link {
                color: #f3d398;
                font-size: 12px;
                max-width: 210px
            }

        .drop {
            position: relative
        }

        .drop-panel {
            position: absolute;
            top: calc(100% + 24px);
            right: -55px;
            width: min(350px,90vw);
            padding: 17px;
            background: white;
            color: var(--ink);
            border: 1px solid var(--line);
            border-radius: 13px;
            box-shadow: 0 18px 55px #071b3040
        }

            .drop-panel[hidden] {
                display: none
            }

        .drop-title {
            font-weight: 800;
            font-size: 13px;
            margin: 0 0 10px
        }

        .drop-panel input {
            width: 100%;
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 11px;
            outline-color: var(--teal)
        }

        .drop-list {
            max-height: 290px;
            overflow-y: auto;
            margin-top: 9px
        }

            .drop-list a {
                display: block;
                padding: 10px;
                text-decoration: none;
                font-size: 13px;
                border-radius: 7px
            }

                .drop-list a:hover {
                    background: #e9f5f5
                }

        .intro {
            background: linear-gradient(110deg,#10253a,#1a4057);
            color: #fff;
            padding: 47px 0 51px
        }

            .intro h1 {
                font-size: clamp(29px,4vw,43px);
                letter-spacing: -1.1px;
                margin: 0 0 10px;
                font-weight: 850
            }

            .intro p {
                color: #d0dde7;
                margin: 0 0 24px;
                font-size: 15px;
                line-height: 1.7
            }

        .intro-top {
            display: flex;
            justify-content: space-between;
            gap: 24px;
            align-items: center
        }

        .intro-meta {
            font-size: 13px;
            color: #d3e3eb;
            white-space: nowrap
        }

            .intro-meta strong {
                color: var(--gold);
                font-size: 24px;
                margin-right: 5px
            }

        .search-box {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #fff;
            color: var(--ink);
            padding: 8px;
            border-radius: 12px;
            max-width: 780px;
            box-shadow: 0 9px 25px #0415252e
        }

        .search-icon {
            font-size: 21px;
            color: var(--teal);
            margin-left: 12px
        }

        .search-box input {
            border: 0;
            outline: 0;
            min-width: 0;
            flex: 1;
            padding: 12px 2px;
            font: 15px 'Segoe UI',Arial,sans-serif;
            color: var(--ink)
        }

        .search-action {
            border: 0;
            background: var(--teal);
            color: #fff;
            padding: 13px 25px;
            border-radius: 8px;
            font-weight: 750;
            cursor: pointer;
            font-size: 14px
        }

            .search-action:hover {
                background: #066c71
            }

        .directory {
            padding: 38px 0 66px;
            scroll-margin-top: 90px
        }

        .section-head {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 20px
        }

            .section-head h2 {
                font-size: 25px;
                letter-spacing: -.5px;
                margin: 0 0 6px
            }

            .section-head p {
                margin: 0;
                color: var(--muted);
                font-size: 14px
            }

        .result-count {
            font-size: 13px;
            color: var(--teal);
            background: #e5f3f2;
            border: 1px solid #c6e5e3;
            padding: 9px 13px;
            border-radius: 99px;
            font-weight: 800;
            white-space: nowrap
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 17px
        }
        /* Dernek rehberi: premium, kompakt ve dengeli kartlar */
        .dernek-card {
            position: relative;
            display: flex;
            flex-direction: column;
            min-height: 390px;
            padding: 0;
            background: #fff;
            border: 1px solid #dce6ec;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 7px 22px rgba(16,40,60,.06);
            transition: box-shadow .22s,transform .22s,border-color .22s
        }

        .directory-pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 28px
        }

            .directory-pagination button {
                border: 1px solid #cddde2;
                border-radius: 10px;
                background: white;
                color: #153449;
                padding: 10px 15px;
                font: 700 13px 'Segoe UI',Arial,sans-serif;
                cursor: pointer
            }

                .directory-pagination button.active {
                    background: #087e83;
                    color: white;
                    border-color: #087e83
                }

                .directory-pagination button:disabled {
                    opacity: .45;
                    cursor: not-allowed
                }

        .dernek-card::before {
            content: "";
            height: 5px;
            background: linear-gradient(90deg,#0b858a,#52b9b1 65%,#e4b66b);
            display: block;
            flex-shrink: 0
        }

        .dernek-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 17px 38px rgba(16,40,60,.13);
            border-color: #a5d4d2
        }

        .dernek-card[hidden], .drop-list a[hidden] {
            display: none
        }

        .card-top {
            display: flex;
            gap: 16px;
            align-items: center;
            padding: 23px 23px 16px
        }

        .dernek-logo, .placeholder {
            width: 78px;
            height: 78px;
            flex-shrink: 0;
            border-radius: 16px;
            background: #f0f5f8;
            border: 1px solid #e5edf1
        }

        .dernek-logo {
            object-fit: contain;
            padding: 8px
        }

        .placeholder {
            display: grid;
            place-items: center;
            font-size: 33px;
            color: var(--teal)
        }

        .card-title {
            min-width: 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 8px
        }

        .dernek-card h3 {
            font-size: 17px;
            line-height: 1.35;
            margin: 0;
            color: #112c41;
            font-weight: 800;
            overflow-wrap: anywhere
        }

        .card-category {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #087d83;
            font-size: 11px;
            font-weight: 750;
            background: #eaf7f5;
            padding: 5px 9px;
            border-radius: 999px
        }

            .card-category::before {
                content: "";
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #0c9b8c
            }

        .dernek-card p {
            color: #667989;
            font-size: 13px;
            line-height: 1.7;
            margin: 0 23px 19px;
            display: -webkit-box;
            -webkit-line-clamp: 7;
            -webkit-box-orient: vertical;
            overflow: hidden;
            flex: 1;
            min-height: 165px
        }

        .card-bottom {
            border-top: 1px solid #edf1f4;
            margin-top: auto;
            padding: 13px 23px 17px;
            background: #fbfcfd
        }

        .visit {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            color: #fff;
            background: #087f85;
            text-decoration: none;
            font-size: 13px;
            font-weight: 800;
            padding: 12px 15px;
            border-radius: 10px;
            transition: background .2s
        }

            .visit:hover {
                background: #09676c
            }

        .visit-arrow {
            font-size: 18px;
            line-height: 1
        }

        .empty {
            padding: 28px;
            border: 1px dashed #b4c8d3;
            background: #fff;
            border-radius: 12px;
            color: var(--muted);
            text-align: center
        }

            .empty[hidden] {
                display: none
            }

        .about {
            background: #e9eff4;
            padding: 28px 0;
            border-top: 1px solid var(--line)
        }

        .about-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px
        }

        .about h2 {
            font-size: 18px;
            margin: 0 0 7px
        }

        .about p {
            font-size: 13px;
            color: #536a7a;
            line-height: 1.7;
            max-width: 780px;
            margin: 0
        }

        .about a {
            font-size: 13px;
            font-weight: 800;
            color: var(--teal);
            text-decoration: none;
            white-space: nowrap
        }

        footer {
            text-align: center;
            background: #0c2033;
            color: #b9cbd8;
            padding: 23px 15px;
            font-size: 12px
        }

        .developer-credit {
            color: var(--gold);
            margin-top: 8px;
            font-weight: 650
        }

        @@media(max-width:960px) {
            .grid {
                grid-template-columns: repeat(2,minmax(0,1fr))
            }

            .navlinks {
                gap: 12px
            }

            .nav {
                flex-wrap: wrap;
                padding: 14px 0;
                justify-content: center
            }
        }

        @@media(max-width:620px) {
            .shell {
                padding: 0 16px
            }

            .navlinks {
                flex-wrap: wrap;
                justify-content: center;
                gap: 13px
            }

            .intro {
                padding: 32px 0 36px
            }

            .intro-top {
                display: block
            }

            .intro-meta {
                margin: 14px 0
            }

            .search-action {
                padding: 12px 17px
            }

            .grid {
                grid-template-columns: 1fr
            }

            .section-head {
                align-items: flex-start;
                flex-direction: column
            }

            .about-inner {
                align-items: flex-start;
                flex-direction: column
            }

            .drop-panel {
                right: 50%;
                transform: translateX(50%)
            }

            .directory {
                padding: 29px 0 48px
            }
        }

        @@media(prefers-reduced-motion:reduce) {
            html {
                scroll-behavior: auto
            }

            * {
                transition: none !important
            }
        }
        /* DERNEKNET ücretsiz bilgi asistanı */
        .dn-chat-launcher {
            position: fixed;
            right: 22px;
            bottom: 22px;
            z-index: 1001;
            border: 0;
            border-radius: 999px;
            background: #087e83;
            color: #fff;
            padding: 15px 19px;
            box-shadow: 0 10px 32px rgba(0,45,50,.25);
            font: 700 14px 'Segoe UI',sans-serif;
            cursor: pointer
        }

            .dn-chat-launcher:hover {
                background: #06696e
            }

        .dn-chat-window {
            position: fixed;
            right: 22px;
            bottom: 85px;
            width: min(365px,calc(100vw - 24px));
            height: min(510px,calc(100dvh - 115px));
            z-index: 1002;
            background: #fff;
            color: #1b3040;
            border: 1px solid #d6e7e5;
            border-radius: 19px;
            box-shadow: 0 20px 65px rgba(0,32,42,.27);
            display: flex;
            flex-direction: column;
            overflow: hidden
        }

            .dn-chat-window[hidden] {
                display: none
            }

        .dn-chat-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #087e83;
            color: #fff;
            padding: 15px 17px
        }

            .dn-chat-head strong {
                font-size: 15px
            }

            .dn-chat-head small {
                display: block;
                margin-top: 3px;
                color: #d8f5ef;
                font-size: 11px
            }

        .dn-chat-close {
            border: 0;
            background: transparent;
            color: #fff;
            font-size: 25px;
            cursor: pointer;
            line-height: 1;
            padding: 0 4px
        }

        .dn-chat-messages {
            padding: 15px;
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
            background: #f7fbfa;
            overscroll-behavior: contain
        }

        .dn-chat-bubble {
            padding: 11px 13px;
            max-width: 88%;
            border-radius: 14px;
            font-size: 13px;
            line-height: 1.55;
            white-space: pre-wrap;
            overflow-wrap: anywhere
        }

            .dn-chat-bubble.bot {
                align-self: flex-start;
                background: #e8f0f1;
                color: #203c49;
                border-bottom-left-radius: 4px
            }

            .dn-chat-bubble.user {
                align-self: flex-end;
                background: #087e83;
                color: #fff;
                border-bottom-right-radius: 4px
            }

        .dn-chat-suggestions {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            padding: 10px 12px;
            border-top: 1px solid #e3ebeb
        }

            .dn-chat-suggestions button {
                border: 1px solid #9bd1cc;
                background: #effaf7;
                color: #087477;
                border-radius: 18px;
                padding: 6px 9px;
                font-size: 11px;
                cursor: pointer
            }

        .dn-chat-compose {
            display: flex;
            gap: 8px;
            padding: 11px;
            border-top: 1px solid #e3ebeb
        }

            .dn-chat-compose input {
                min-width: 0;
                flex: 1;
                border: 1px solid #cadbdc;
                border-radius: 10px;
                padding: 11px;
                color: #1b3040;
                background: #fff;
                font-size: 13px;
                outline-color: #087e83
            }

            .dn-chat-compose button {
                background: #087e83;
                color: #fff;
                border: 0;
                border-radius: 10px;
                padding: 0 14px;
                font-weight: 700;
                cursor: pointer
            }

        .dn-chat-contact {
            display: block;
            text-align: center;
            padding: 9px;
            background: #eaf7f0;
            color: #08704f;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none
        }

            .dn-chat-contact:hover {
                text-decoration: underline
            }

        @@media (max-width:480px) {
            .dn-chat-launcher {
                right: 12px;
                bottom: 12px
            }

            .dn-chat-window {
                right: 12px;
                bottom: 74px;
                width: calc(100vw - 24px);
                height: min(540px,calc(100dvh - 94px))
            }
        }

    </style>
</head>
<body>
    <header class="topbar">
        <div class="shell nav">
            <a class="logo" href="/">DERNEK<span>NET</span></a>
            <nav class="navlinks" aria-label="Ana menü">
                <a href="#anasayfa">Ana Sayfa</a>
                <div class="drop" id="dernekMenu">
                    <button type="button" class="drop-toggle" id="dernekToggle" aria-expanded="false" aria-controls="dernekPanel">Dernekler ▾</button>
                    <div class="drop-panel" id="dernekPanel" hidden>
                        <p class="drop-title">Kayıtlı dernekler</p>
                        <input type="search" id="menuSearch" placeholder="Dernek adı ara..." aria-label="Menüde dernek ara" autocomplete="off" />
                        <div class="drop-list" id="menuList">
                            @foreach (var dernek in dernekler)
                            {
                                <a asp-area="" asp-controller="Dernek" asp-action="Index" asp-route-id="@dernek.Id" data-name="@dernek.DernekAdi">@dernek.DernekAdi</a>
                            }
                        </div>
                        @if (!dernekler.Any())
                        {
                            <p class="empty">Henüz aktif dernek yok.</p>
                        }
                        <p id="menuEmpty" class="empty" hidden>Aradığınız dernek bulunamadı.</p>
                    </div>
                </div>
                <a href="#hakkimizda">Hakkımızda</a>
                <a href="/Identity/Account/Login" class="login">Giriş Yap</a>
                <a href="https://wa.me/905537903072?text=Merhaba%2C%20DERNEKNET%20platformunda%20dernek%20olu%C5%9Fturmak%20istiyorum." target="_blank" rel="noopener noreferrer" class="whatsapp-link">💬 Dernek oluşturmak ister misiniz?</a>
            </nav>
        </div>
    </header>
    <section class="intro" id="anasayfa">
        <div class="shell">
            <div class="intro-top">
                <div><h1>Türkiye'nin Dernek Rehberi</h1><p>Dernekleri keşfedin, faaliyetlerini inceleyin ve kolayca iletişim kurun.</p></div>
                <div class="intro-meta"><strong>@dernekler.Count</strong> aktif dernek</div>
            </div>
            <div class="search-box" role="search">
                <span class="search-icon" aria-hidden="true">⌕</span>
                <input type="search" id="mainSearch" placeholder="Dernek adıyla arayın..." aria-label="Dernek adıyla arayın" autocomplete="off" />
                <button type="button" class="search-action" id="searchGo">Ara →</button>
            </div>
        </div>
    </section>
    <main class="directory" id="dernekler">
        <div class="shell">
            <div class="section-head">
                <div><h2>Derneklerimiz</h2><p>Platformdaki aktif dernekleri inceleyin ve profillerini ziyaret edin.</p></div>
                <span class="result-count" id="resultCount">@dernekler.Count dernek</span>
            </div>
            <div class="grid" id="dernekGrid">
                @foreach (var dernek in dernekler)
                {
                    <article class="dernek-card" data-name="@dernek.DernekAdi">
                        <div class="card-top">
                            @if (!string.IsNullOrWhiteSpace(dernek.LogoUrl))
                            {
                                <img class="dernek-logo" src="@dernek.LogoUrl" alt="@dernek.DernekAdi logosu" loading="lazy" />
                            }
                            else
                            {
                                <div class="placeholder" aria-hidden="true">🏛️</div>
                            }
                            <div class="card-title">
                                <h3>@dernek.DernekAdi</h3>
                                <span class="card-category">Dernek profili</span>
                            </div>
                        </div>
                        <p>@(string.IsNullOrWhiteSpace(dernek.Aciklama) ? "Derneğin faaliyetlerini, duyurularını ve çalışmalarını keşfedin." : dernek.Aciklama)</p>
                        <div class="card-bottom">
                            <a class="visit" asp-area="" asp-controller="Dernek" asp-action="Index" asp-route-id="@dernek.Id">Derneği Ziyaret Et <span class="visit-arrow" aria-hidden="true">→</span></a>
                        </div>
                    </article>
                }
            </div>
            <div id="dernekPagination" class="directory-pagination" aria-label="Dernek sayfaları"></div>
            <div class="empty" id="noResults" hidden>Aramanıza uygun dernek bulunamadı. Başka bir isim deneyin.</div>
            @if (!dernekler.Any())
            {
                <div class="empty">Henüz aktif dernek bulunmuyor.</div>
            }
        </div>
    </main>
    <section class="about" id="hakkimizda">
        <div class="shell about-inner">
            <div><h2>DERNEKNET Hakkında</h2><p>DERNEKNET, derneklerin kendi dijital alanlarında duyurularını, etkinliklerini ve gönüllülük çalışmalarını paylaşabildiği ortak bir platformdur.</p></div>
            <a href="https://wa.me/905537903072?text=Merhaba%2C%20DERNEKNET%20platformunda%20dernek%20olu%C5%9Fturmak%20istiyorum." target="_blank" rel="noopener noreferrer">Derneğinizi ekleyin →</a>
        </div>
    </section>
    <footer><div>© @DateTime.Now.Year DERNEKNET · Tüm hakları saklıdır.</div><div class="developer-credit">Developed by Yavuzhan Sarmaşık</div></footer>
    <!-- Ücretsiz, sunucu/API gerektirmeyen DERNEKNET bilgi asistanı -->
    <button type="button" id="dnChatLauncher" class="dn-chat-launcher" aria-controls="dnChatWindow" aria-expanded="false">💬 Yardım Asistanı</button>
    <section id="dnChatWindow" class="dn-chat-window" role="dialog" aria-label="DERNEKNET bilgi asistanı" hidden>
        <div class="dn-chat-head"><div><strong>🤖 DERNEKNET Asistan</strong><small>Platform hakkında hızlı yanıtlar</small></div><button type="button" class="dn-chat-close" id="dnChatClose" aria-label="Sohbeti kapat">×</button></div>
        <div id="dnChatMessages" class="dn-chat-messages" role="log" aria-live="polite" aria-relevant="additions"></div>
        <div class="dn-chat-suggestions" id="dnChatSuggestions">
            <button type="button" data-question="DERNEKNET nedir?">DERNEKNET nedir?</button>
            <button type="button" data-question="Derneğimi nasıl eklerim?">Dernek ekleme</button>
            <button type="button" data-question="AFAD gönüllülüğü nedir?">AFAD gönüllülüğü</button>
            <button type="button" data-question="Nasıl giriş yaparım?">Giriş yapma</button>
        </div>
        <form id="dnChatForm" class="dn-chat-compose">
            <input id="dnChatInput" type="text" maxlength="300" autocomplete="off" placeholder="Sorunuzu yazın..." aria-label="Sorunuz" required />
            <button type="submit">Gönder</button>
        </form>
        <a class="dn-chat-contact" href="https://wa.me/905537903072?text=Merhaba%2C%20DERNEKNET%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum." target="_blank" rel="noopener noreferrer">WhatsApp ile iletişime geç →</a>
    </section>
    <script>
        (function(){
            const normalize=value=>(value||'').toLocaleLowerCase('tr-TR').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim();
            const mainSearch=document.getElementById('mainSearch');
            const cards=Array.from(document.querySelectorAll('.dernek-card'));
            const count=document.getElementById('resultCount');
            const noResults=document.getElementById('noResults');
            const pagination=document.getElementById('dernekPagination');
            const pageSize=3;
            let currentPage=1;
            function filterCards(resetPage=false){
                if(resetPage)currentPage=1;
                const q=normalize(mainSearch.value);
                const matches=cards.filter(card=>normalize(card.dataset.name).includes(q));
                const totalPages=Math.ceil(matches.length/pageSize);
                currentPage=Math.min(Math.max(currentPage,1),Math.max(totalPages,1));
                cards.forEach(card=>card.hidden=true);
                matches.slice((currentPage-1)*pageSize,currentPage*pageSize).forEach(card=>card.hidden=false);
                count.textContent=matches.length+' dernek';
                noResults.hidden=matches.length!==0||cards.length===0;
                pagination.replaceChildren();
                if(totalPages>1){
                    function addButton(label,page,disabled,active){
                        const button=document.createElement('button');
                        button.type='button';button.textContent=label;button.disabled=disabled;
                        if(active){button.classList.add('active');button.setAttribute('aria-current','page');}
                        button.addEventListener('click',()=>{currentPage=page;filterCards();document.getElementById('dernekler').scrollIntoView({behavior:'smooth'});});
                        pagination.appendChild(button);
                    }
                    addButton('← Önceki',currentPage-1,currentPage===1,false);
                    for(let page=1;page<=totalPages;page++)addButton(String(page),page,false,page===currentPage);
                    addButton('Sonraki →',currentPage+1,currentPage===totalPages,false);
                }
            }
            mainSearch.addEventListener('input',()=>filterCards(true));
            document.getElementById('searchGo').addEventListener('click',()=>{filterCards(true);document.getElementById('dernekler').scrollIntoView({behavior:'smooth'});});
            mainSearch.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();document.getElementById('searchGo').click();}});
            filterCards();
            const menu=document.getElementById('dernekMenu'),toggle=document.getElementById('dernekToggle'),panel=document.getElementById('dernekPanel'),menuSearch=document.getElementById('menuSearch'),links=Array.from(document.querySelectorAll('#menuList a')),menuEmpty=document.getElementById('menuEmpty');
            function closeMenu(){panel.hidden=true;toggle.setAttribute('aria-expanded','false');}
            toggle.addEventListener('click',()=>{const open=panel.hidden;panel.hidden=!open;toggle.setAttribute('aria-expanded',String(open));if(open)menuSearch.focus();});
            document.addEventListener('click',e=>{if(!menu.contains(e.target))closeMenu();});
            document.addEventListener('keydown',e=>{if(e.key==='Escape')closeMenu();});
            menuSearch.addEventListener('input',()=>{const q=normalize(menuSearch.value);let visible=0;links.forEach(link=>{const match=normalize(link.dataset.name).includes(q);link.hidden=!match;if(match)visible++;});menuEmpty.hidden=visible!==0||links.length===0;});
        })();
    </script>
    <script>
        (function () {
            const launcher = document.getElementById('dnChatLauncher');
            const windowEl = document.getElementById('dnChatWindow');
            const closeBtn = document.getElementById('dnChatClose');
            const messages = document.getElementById('dnChatMessages');
            const form = document.getElementById('dnChatForm');
            const input = document.getElementById('dnChatInput');
            const normalizeText = (value) => (value || '').toLocaleLowerCase('tr-TR').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ı/g,'i');
            function addMessage(text, kind) {
                const bubble = document.createElement('div');
                bubble.className = 'dn-chat-bubble ' + kind;
                bubble.textContent = text;
                messages.appendChild(bubble);
                messages.scrollTop = messages.scrollHeight;
            }
            function answer(question) {
                const q = normalizeText(question);
                if (/merhaba|selam|iyi gunler/.test(q)) return 'Merhaba! DERNEKNET hakkında sorularınızı yanıtlayabilirim. Dernek ekleme, üyeler, duyurular, etkinlikler, anketler veya AFAD hakkında sorabilirsiniz.';
                if (/fiyat|ucret|paket|abonelik|odeme|bedava|ucretsiz/.test(q)) return 'Güncel ücret ve kullanım koşulları için platform yöneticisine WhatsApp üzerinden ulaşabilirsiniz. Burada doğrulanmış bir fiyat listesi bulunmuyor.';
                if (/dernek.*(ekle|olustur|kaydet|ac|basvur)|nasil.*dernek|dernegimi/.test(q)) return 'DERNEKNET platformuna derneğinizi ekletmek için sayfanın üstündeki “Dernek oluşturmak ister misiniz?” bağlantısını kullanarak WhatsApp üzerinden iletişime geçebilirsiniz.';
                if (/afad|gonullu|afet|tatbikat|yetkinlik|egitim/.test(q)) return 'DERNEKNET, derneklerin afet gönüllülerini ve AFAD çalışmalarını yönetmesine yardımcı olan bölümler içerir. Gönüllüler normal dernek üyesi olmak zorunda değildir; bir derneğin AFAD birimine bağlı kayıt oluşturabilirler. Başvuru ve kullanım ayrıntıları için ilgili dernekle görüşün.';
                if (/giris|oturum|sifre|hesap|yonetici|panel/.test(q)) return 'Yönetim paneline giriş için üst menüdeki “Giriş Yap” butonunu kullanın. Hesabınız veya erişiminiz yoksa platform yöneticisiyle iletişime geçin.';
                if (/uye|uyelik|kayitli kisi/.test(q)) return 'Dernek yöneticileri yetkili oldukları yönetim panelinden üyeleri görüntüleyebilir, ekleyebilir ve bilgilerini düzenleyebilir.';
                if (/duyuru|haber|etkinlik|takvim/.test(q)) return 'Dernekler kendi sayfalarında duyuru ve etkinliklerini paylaşabilir. Güncel içerikleri görmek için ana sayfadan ilgili derneği seçin.';
                if (/anket|oylama|oy ver/.test(q)) return 'DERNEKNET’te dernekler anket oluşturabilir ve sonuçlarını yönetebilir. Anketleri ilgili derneğin sayfasında bulabilirsiniz.';
                if (/derneknet nedir|ne ise yarar|platform|hakkinda|nedir/.test(q)) return 'DERNEKNET, derneklerin dijital ortamda kendilerini tanıtabildiği; duyuru, etkinlik, anket, üye ve gönüllülük çalışmalarını yönetebildiği bir platformdur.';
                if (/iletisim|whatsapp|telefon|ulas/.test(q)) return 'Platform yöneticisiyle iletişim için sohbet penceresinin altındaki “WhatsApp ile iletişime geç” bağlantısını kullanabilirsiniz.';
                return 'Bu soruya ilişkin hazır bir yanıtım bulunmuyor. DERNEKNET hakkında dernek ekleme, üyeler, duyurular, etkinlikler, anketler, AFAD veya giriş işlemlerini sorabilirsiniz. Diğer konular için WhatsApp bağlantısını kullanın.';
            }
            function ask(question) {
                const value = (question || '').trim();
                if (!value) return;
                addMessage(value, 'user');
                addMessage(answer(value), 'bot');
            }
            function setOpen(open) {
                windowEl.hidden = !open;
                launcher.setAttribute('aria-expanded', String(open));
                if (open) input.focus(); else launcher.focus();
            }
            launcher.addEventListener('click', () => setOpen(windowEl.hidden));
            closeBtn.addEventListener('click', () => setOpen(false));
            document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !windowEl.hidden) setOpen(false); });
            form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); input.value = ''; input.focus(); });
            document.querySelectorAll('#dnChatSuggestions [data-question]').forEach((button) => button.addEventListener('click', () => ask(button.dataset.question)));
            addMessage('Merhaba! 👋 Ben DERNEKNET bilgi asistanıyım. Platform hakkında merak ettiklerinizi sorabilirsiniz.', 'bot');
        })();
    </script>
</body>
</html>
