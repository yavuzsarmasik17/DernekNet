@{
    var sayfaBasligi = ViewData["Title"]?.ToString() ?? "Dernek Yönetimi";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string menuAktif(string hedefController) => string.Equals(controller, hedefController, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    string menuAktifSayfa(string hedefController, string hedefAction) =>
        string.Equals(controller, hedefController, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(action, hedefAction, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@sayfaBasligi | DERNEKNET</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=1" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            color-scheme: dark;
            --dn-bg: #0b111b;
            --dn-sidebar: #101925;
            --dn-panel: #162231;
            --dn-raised: #1e2c3c;
            --dn-border: #2a394a;
            --dn-text: #e9edf4;
            --dn-muted: #a1afbf;
            --dn-accent: #c9a46a;
            --dn-teal: #4cc6b1;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--dn-bg);
            color: var(--dn-text);
            font-family: Inter,"Segoe UI",Arial,sans-serif;
        }

        .dn-sidebar {
            width: 276px;
            position: fixed;
            inset: 0 auto 0 0;
            background: linear-gradient(180deg,#141f2d,#0f1823);
            border-right: 1px solid var(--dn-border);
            overflow-y: auto;
            padding: 24px 14px;
            z-index: 1050;
            scrollbar-width: thin;
            scrollbar-color: #34465b transparent;
        }

        .dn-brand {
            padding: 4px 12px 23px;
            border-bottom: 1px solid var(--dn-border);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .dn-brand-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: linear-gradient(135deg,#d8b77d,#957244);
            color: #111923;
            font-size: 21px;
        }

        .dn-brand-name {
            font-size: 20px;
            letter-spacing: 1px;
            font-weight: 800;
        }

        .dn-brand small {
            display: block;
            font-size: 11px;
            color: var(--dn-muted);
            letter-spacing: .3px;
            margin-top: 3px;
        }

        .dn-menu-label {
            padding: 20px 13px 9px;
            color: #8395a9;
            font-size: 10px;
            letter-spacing: 1.8px;
            font-weight: 800;
        }

        .dn-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 13px;
            margin: 3px 0;
            border: 1px solid transparent;
            border-radius: 11px;
            color: #b9c6d6;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: background .18s,color .18s,border-color .18s;
        }

            .dn-menu a i {
                font-size: 17px;
                width: 22px;
                text-align: center;
                flex-shrink: 0;
            }

            .dn-menu a:hover {
                background: #233346;
                color: #f1f5fa;
            }

            .dn-menu a.active {
                color: #f6e4c4;
                background: linear-gradient(90deg,rgba(201,164,106,.19),rgba(201,164,106,.035));
                border-left: 3px solid var(--dn-accent);
            }

        .dn-afad-label, .dn-afad-link i {
            color: var(--dn-teal) !important;
        }

        .dn-menu .dn-afad-link.active {
            background: rgba(76,198,177,.12);
            border-left-color: var(--dn-teal);
            color: #b9f5e9;
        }

        .dn-main {
            margin-left: 276px;
            min-height: 100vh;
        }

        .dn-topbar {
            min-height: 86px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 17px 34px;
            background: #121d2a;
            border-bottom: 1px solid var(--dn-border);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .dn-topbar-left {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .dn-topbar-kicker {
            font-size: 10px;
            letter-spacing: 1.7px;
            color: var(--dn-accent);
            font-weight: 800;
        }

        .dn-topbar-title {
            font-size: 21px;
            font-weight: 750;
            line-height: 1.25;
            overflow-wrap: anywhere;
        }

        .dn-topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .dn-status {
            color: var(--dn-muted);
            font-size: 12px;
            white-space: nowrap;
        }

            .dn-status i {
                color: var(--dn-teal);
                margin-right: 5px;
            }

        .dn-logout {
            border: 1px solid #5a3e44;
            background: #2a2029;
            color: #ffbdc4;
            border-radius: 10px;
            padding: 9px 14px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

            .dn-logout:hover {
                background: #4a2a34;
                color: #ffe5e8;
            }

        .dn-content {
            max-width: 1600px;
            margin: 0 auto;
            padding: 32px;
        }

        .dn-card, .admin-card, .card {
            background: var(--dn-panel);
            border: 1px solid var(--dn-border);
            border-radius: 16px;
            color: var(--dn-text);
            box-shadow: 0 12px 28px rgba(0,0,0,.12);
        }

        .dn-card {
            padding: 26px;
            height: 100%;
        }

            .dn-card h3 {
                font-size: 15px;
                color: var(--dn-muted);
            }

        .dn-number {
            font-size: 38px;
            font-weight: 800;
            color: var(--dn-text);
        }

        .dn-content .table {
            --bs-table-bg: transparent;
            --bs-table-color: var(--dn-text);
            --bs-table-border-color: var(--dn-border);
            --bs-table-striped-bg: #1e2d3e;
            --bs-table-striped-color: var(--dn-text);
            --bs-table-hover-bg: #27394d;
            --bs-table-hover-color: var(--dn-text);
            color: var(--dn-text);
        }

        .dn-content .form-control, .dn-content .form-select, .dn-content textarea, .dn-content .input-group-text {
            background: #101a27;
            border-color: #35475a;
            color: var(--dn-text);
        }

            .dn-content .form-control:focus, .dn-content .form-select:focus {
                background: #152234;
                color: var(--dn-text);
                border-color: var(--dn-accent);
                box-shadow: 0 0 0 .2rem rgba(201,164,106,.12);
            }

            .dn-content .form-control::placeholder {
                color: #8797a9;
            }

        .dn-content .text-muted, .dn-content .form-text {
            color: var(--dn-muted) !important;
        }

        .dn-content .modal-content, .dn-content .dropdown-menu {
            background: #182638;
            color: var(--dn-text);
            border-color: var(--dn-border);
        }

        .dn-content .dropdown-item {
            color: var(--dn-text);
        }

            .dn-content .dropdown-item:hover {
                background: #26394e;
            }

        .dn-content .btn-primary {
            background: #ad8953;
            border-color: #ad8953;
            color: #101720;
            font-weight: 700;
        }

            .dn-content .btn-primary:hover {
                background: #d1ad72;
                border-color: #d1ad72;
            }

        .dn-content .btn-outline-secondary {
            color: #c3cfdd;
            border-color: #607287;
        }

            .dn-content .btn-outline-secondary:hover {
                background: #33475c;
                color: #fff;
            }

        .dn-content .page-link {
            background: #172537;
            border-color: #35465a;
            color: #d9e3ef;
        }

        .dn-content .page-item.active .page-link {
            background: #9c7949;
            border-color: #9c7949;
        }

        .dn-menu-toggle {
            display: none;
            border: 1px solid var(--dn-border);
            border-radius: 10px;
            background: #1d2d3e;
            color: var(--dn-text);
            padding: 8px 11px;
            font-size: 20px;
        }

        .dn-overlay {
            display: none;
        }

        @@media (max-width: 991px) {
            .dn-sidebar {
                transform: translateX(-100%);
                transition: transform .22s ease;
                width: min(300px,86vw);
            }

            body.dn-menu-open .dn-sidebar {
                transform: translateX(0);
            }

            body.dn-menu-open .dn-overlay {
                display: block;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.65);
                z-index: 1040;
            }

            .dn-main {
                margin-left: 0;
            }

            .dn-menu-toggle {
                display: inline-flex;
            }

            .dn-topbar {
                padding: 14px 18px;
                min-height: 76px;
            }

            .dn-content {
                padding: 18px;
            }

            .dn-status {
                display: none;
            }
        }

        @@media (max-width: 540px) {
            .dn-topbar-title {
                font-size: 17px;
            }

            .dn-topbar-kicker {
                font-size: 9px;
            }

            .dn-logout {
                padding: 9px 10px;
                font-size: 0;
            }

                .dn-logout i {
                    font-size: 17px;
                }

            .dn-content {
                padding: 14px;
            }
        }

        /* DERNEKNET: tüm modüllerde tutarlı koyu yüzeyler */
        .dn-content {
            color: #e9edf4;
        }

            .dn-content :is(.card,.card-body,.card-header,.card-footer,.admin-card,.admin-card-body,.admin-card-header,.dn-card,.bg-white,.bg-light,.bg-body,.bg-body-tertiary,.list-group-item,.accordion-item,.accordion-button,.modal-content,.dropdown-menu,.alert-light) {
                background-color: #172536 !important;
                color: #e9edf4 !important;
                border-color: #35465a !important;
            }

            .dn-content :is(.card-header,.admin-card-header,.card-footer,.accordion-button,.table-light,.table-secondary) {
                background-color: #203146 !important;
            }

            .dn-content :is(.card,.admin-card,.dn-card,.list-group-item,.accordion-item) {
                border: 1px solid #35465a !important;
            }

            .dn-content :is(.table,.table-striped,.table-hover,.table-bordered) {
                --bs-table-bg: #172536 !important;
                --bs-table-color: #e9edf4 !important;
                --bs-table-border-color: #35465a !important;
                --bs-table-striped-bg: #203146 !important;
                --bs-table-striped-color: #e9edf4 !important;
                --bs-table-hover-bg: #2b4055 !important;
                --bs-table-hover-color: #fff !important;
                color: #e9edf4 !important;
                background-color: #172536 !important;
            }

            .dn-content .table :is(thead,tbody,tfoot,tr,th,td) {
                background-color: transparent !important;
                color: #e9edf4 !important;
                border-color: #35465a !important;
                box-shadow: none !important;
            }

            .dn-content .table thead :is(th,td) {
                background-color: #203146 !important;
                color: #f1d6a5 !important;
            }

            .dn-content .table-striped tbody tr:nth-of-type(odd) > * {
                background-color: #1e2d40 !important;
            }

            .dn-content :is(h1,h2,h3,h4,h5,h6,.card-title,.card-header,.admin-card-header,.fw-bold,.fw-semibold) {
                color: #f0f4fa;
            }

            .dn-content :is(p,small,label,.form-label,.card-text,.list-group-item,.accordion-body) {
                color: #cbd7e5;
            }

            .dn-content :is(.text-muted,.text-secondary,.form-text,.small.text-muted) {
                color: #aebfd0 !important;
            }

            .dn-content :is(.text-dark,.text-body,.text-black) {
                color: #e9edf4 !important;
            }

            .dn-content :is(.form-control,.form-select,textarea,.input-group-text) {
                background-color: #101b29 !important;
                color: #eef3f9 !important;
                border: 1px solid #42566c !important;
            }

            .dn-content :is(.form-control,.form-select,textarea)::placeholder {
                color: #a1b1c4 !important;
                opacity: 1;
            }

            .dn-content :is(.form-control,.form-select,textarea):focus {
                background-color: #15263a !important;
                color: #fff !important;
                border-color: #c9a46a !important;
                box-shadow: 0 0 0 .2rem rgba(201,164,106,.15) !important;
            }

            .dn-content :is(.form-control,.form-select):disabled {
                background-color: #263445 !important;
                color: #aebfd0 !important;
            }

            .dn-content .btn-outline-primary {
                color: #8cb9ff;
                border-color: #5b8ad3;
            }

                .dn-content .btn-outline-primary:hover {
                    background-color: #24528b;
                    color: #fff;
                }

            .dn-content .btn-outline-secondary {
                color: #d1dbe7;
                border-color: #60738a;
            }

                .dn-content .btn-outline-secondary:hover {
                    background-color: #34475d;
                    color: #fff;
                }

            .dn-content .btn-outline-danger {
                color: #ff929c;
                border-color: #c75b67;
            }

                .dn-content .btn-outline-danger:hover {
                    background-color: #9d3644;
                    color: #fff;
                }

            .dn-content .nav-tabs {
                border-color: #35465a;
            }

                .dn-content .nav-tabs .nav-link {
                    color: #9fc2f4;
                }

                    .dn-content .nav-tabs .nav-link.active {
                        background: #203146;
                        color: #f1d6a5;
                        border-color: #35465a;
                    }

            .dn-content .border, .dn-content .border-bottom, .dn-content .border-top {
                border-color: #35465a !important;
            }

            .dn-content hr {
                border-color: #465b70;
                opacity: .8;
            }

            .dn-content .badge.bg-light {
                background: #2c4258 !important;
                color: #e9edf4 !important;
            }

        /* DERNEKNET - KOYU İÇERİK TEMASI */

        .dn-content {
            color: #e8edf5;
        }

            /* Kartlar ve paneller */
            .dn-content .card,
            .dn-content .card-body,
            .dn-content .card-header,
            .dn-content .bg-white,
            .dn-content .bg-light,
            .dn-content .bg-body,
            .dn-content .bg-body-tertiary,
            .dn-content .dn-card,
            .dn-content .alert-light {
                background: #192635 !important;
                color: #e8edf5 !important;
                border-color: #304155 !important;
            }

            /* Başlıklar ve normal metinler */
            .dn-content h1,
            .dn-content h2,
            .dn-content h3,
            .dn-content h4,
            .dn-content h5,
            .dn-content h6,
            .dn-content label,
            .dn-content p,
            .dn-content strong,
            .dn-content .card-title {
                color: #e8edf5;
            }

            /* Açıklama yazıları */
            .dn-content .text-muted,
            .dn-content .text-secondary,
            .dn-content .form-text,
            .dn-content small {
                color: #aebed0 !important;
            }

            /* Tablolar */
            .dn-content .table {
                --bs-table-bg: #192635;
                --bs-table-color: #e8edf5;
                --bs-table-border-color: #304155;
                --bs-table-striped-bg: #202f40;
                --bs-table-striped-color: #e8edf5;
                --bs-table-hover-bg: #26394d;
                --bs-table-hover-color: #ffffff;
                color: #e8edf5 !important;
            }

                .dn-content .table > :not(caption) > * > * {
                    background-color: #192635 !important;
                    color: #e8edf5 !important;
                    border-color: #304155 !important;
                }

            /* Form alanları */
            .dn-content .form-control,
            .dn-content .form-select,
            .dn-content textarea {
                background: #101b29 !important;
                color: #e8edf5 !important;
                border: 1px solid #3a4d63 !important;
            }

                .dn-content .form-control::placeholder,
                .dn-content textarea::placeholder {
                    color: #91a5bd !important;
                }

                .dn-content .form-control:focus,
                .dn-content .form-select:focus {
                    border-color: #c9a46a !important;
                    box-shadow: 0 0 0 3px rgba(201,164,106,.15);
                }

            /* Kartların içindeki çerçeveli alanlar */
            .dn-content .border,
            .dn-content .border-light {
                border-color: #35485d !important;
            }

            /* Açık renkli özel kutular */
            .dn-content [style*="background: white"],
            .dn-content [style*="background:white"],
            .dn-content [style*="background: #fff"],
            .dn-content [style*="background:#fff"],
            .dn-content [style*="background-color: white"],
            .dn-content [style*="background-color:#fff"] {
                background: #192635 !important;
                color: #e8edf5 !important;
            }

            /* Sekmeler */
            .dn-content .nav-tabs {
                border-bottom-color: #35485d;
            }

                .dn-content .nav-tabs .nav-link {
                    color: #aebed0;
                }

                    .dn-content .nav-tabs .nav-link.active {
                        background: #26394d !important;
                        color: #e8edf5 !important;
                        border-color: #35485d !important;
                    }

            /* Açık renkli butonlar */
            .dn-content .btn-light {
                background: #26394d !important;
                color: #e8edf5 !important;
                border-color: #35485d !important;
            }

        .dn-main {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .dn-content {
            width: 100%;
            flex: 1;
        }

        .dn-footer {
            padding: 20px;
            text-align: center;
            background: #121d2a;
            border-top: 1px solid #2a394a;
            color: #94a3b8;
            font-size: 12px;
        }

        .dn-developer {
            display: block;
            margin-top: 6px;
            color: #4cc6b1;
            font-size: 13px;
            font-weight: 600;
        }

    </style>
</head>
<body>
    <div class="dn-overlay" id="dnOverlay" aria-hidden="true"></div>
    <aside class="dn-sidebar" id="dnSidebar" aria-label="Dernek yönetim menüsü">
        <div class="dn-brand">
            <span class="dn-brand-icon"><i class="bi bi-buildings"></i></span>
            <div><div class="dn-brand-name">DERNEKNET</div><small>DERNEK YÖNETİM PANELİ</small></div>
        </div>
        <nav class="dn-menu"
             aria-label="Dernek yönetim menüsü">

            <div class="dn-menu-label">
                GENEL
            </div>

            <a asp-area="DernekAdmin"
               asp-controller="Home"
               asp-action="Index"
               class="@menuAktif("Home")">
                <i class="bi bi-house-door"></i>
                Ana Sayfa
            </a>

            <div class="dn-menu-label">
                DERNEK İŞLEMLERİ
            </div>

            <a asp-area="DernekAdmin"
               asp-controller="Uyeler"
               asp-action="Index"
               class="@menuAktif("Uyeler")">
                <i class="bi bi-people"></i>
                Üyeler
            </a>

            <a asp-area="DernekAdmin"
               asp-controller="YonetimKurulu"
               asp-action="Index"
               class="@menuAktif("YonetimKurulu")">
                <i class="bi bi-person-badge"></i>
                Kurul Yönetimi
            </a>

            <a asp-area="DernekAdmin"
               asp-controller="Duyurular"
               asp-action="Index"
               class="@menuAktif("Duyurular")">
                <i class="bi bi-megaphone"></i>
                Duyurular
            </a>

            <a asp-area="DernekAdmin"
               asp-controller="Etkinlikler"
               asp-action="Index"
               class="@menuAktif("Etkinlikler")">
                <i class="bi bi-calendar-event"></i>
                Etkinlikler
            </a>

            <a asp-area="DernekAdmin"
               asp-controller="Anketler"
               asp-action="Index"
               class="@menuAktif("Anketler")">
                <i class="bi bi-bar-chart-line"></i>
                Anket Yönetimi
            </a>

            <div class="dn-menu-label dn-afad-label">
                <i class="bi bi-shield-check me-1"></i>
                AFAD YÖNETİMİ
            </div>

            <a asp-area="DernekAdmin"
               asp-controller="AfadGonulluler"
               asp-action="Index"
               class="dn-afad-link @menuAktif("AfadGonulluler")">
                <i class="bi bi-person-check"></i>
                Gönüllü Başvuruları
            </a>

            <a asp-area="DernekAdmin"
               asp-controller="AfadHaberler"
               asp-action="Index"
               class="dn-afad-link @menuAktif("AfadHaberler")">
                <i class="bi bi-newspaper"></i>
                AFAD Haberleri
            </a>

            <a asp-area="DernekAdmin"
               asp-controller="AfadDuyurular"
               asp-action="Index"
               class="dn-afad-link @menuAktif("AfadDuyurular")">
                <i class="bi bi-megaphone"></i>
                AFAD Duyuruları
            </a>

            <a asp-area="DernekAdmin"
               asp-controller="AfadGorevler"
               asp-action="Index"
               class="dn-afad-link @menuAktif("AfadGorevler")">
                <i class="bi bi-clipboard-check"></i>
                AFAD Görevleri
            </a>

            <a asp-area="DernekAdmin"
               asp-controller="AfadEgitimler"
               asp-action="Index"
               class="dn-afad-link @menuAktifSayfa("AfadEgitimler", "Index")">
                <i class="bi bi-mortarboard me-2"></i>
                AFAD Eğitimler
            </a>

            <a asp-area="DernekAdmin"
               asp-controller="AfadTatbikatlar"
               asp-action="Index"
               class="dn-afad-link @menuAktifSayfa("AfadTatbikatlar", "Index")">
                <i class="bi bi-calendar-check me-2"></i>
                AFAD Tatbikatlar
            </a>

            <a asp-area="DernekAdmin"
               asp-controller="AfadYetkinlikler"
               asp-action="Index"
               class="dn-afad-link @menuAktifSayfa("AfadYetkinlikler", "Index")">
                <i class="bi bi-award me-2"></i>
                AFAD Yetkinlikler
            </a>

            <a asp-area="DernekAdmin"
               asp-controller="AfadYetkinlikler"
               asp-action="Gonulluler"
               class="dn-afad-link @menuAktifSayfa("AfadYetkinlikler", "Gonulluler")">
                <i class="bi bi-person-badge me-2"></i>
                Gönüllü Yetkinlikleri
            </a>

            <a asp-area="DernekAdmin"
               asp-controller="AfadEkipler"
               asp-action="Index"
               class="dn-afad-link @menuAktifSayfa("AfadEkipler", "Index")">
                <i class="bi bi-people-fill me-2"></i>
                AFAD Ekip Yönetimi
            </a>

            <div class="dn-menu-label">
                AYARLAR
            </div>

            <a asp-area="DernekAdmin"
               asp-controller="DernekAyarlari"
               asp-action="Index"
               class="@menuAktif("DernekAyarlari")">
                <i class="bi bi-gear"></i>
                Dernek Ayarları
            </a>

        </nav>
    </aside>
    <div class="dn-main">
        <header class="dn-topbar">
            <div class="dn-topbar-left">
                <button class="dn-menu-toggle" id="dnMenuToggle" type="button" aria-label="Menüyü aç" aria-controls="dnSidebar" aria-expanded="false"><i class="bi bi-list"></i></button>
                <div><div class="dn-topbar-kicker">YÖNETİM MERKEZİ</div><div class="dn-topbar-title">@sayfaBasligi</div></div>
            </div>
            <div class="dn-topbar-right">
                <span class="dn-status"><i class="bi bi-circle-fill"></i> Yönetim paneli</span>
                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dn-logout"><i class="bi bi-box-arrow-right me-1"></i> Çıkış Yap</button>
                </form>
            </div>
        </header>

        <main class="dn-content">@RenderBody()</main>

        <footer class="dn-footer">
            <span>© @DateTime.Now.Year DERNEKNET</span>
            <span class="dn-developer">
                Developed by Yavuzhan Sarmaşık
            </span>
        </footer>

    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const toggle = document.getElementById('dnMenuToggle');
            const overlay = document.getElementById('dnOverlay');
            function closeMenu() { document.body.classList.remove('dn-menu-open'); toggle.setAttribute('aria-expanded', 'false'); }
            toggle.addEventListener('click', function () {
                const opened = document.body.classList.toggle('dn-menu-open');
                toggle.setAttribute('aria-expanded', opened ? 'true' : 'false');
            });
            overlay.addEventListener('click', closeMenu);
            document.addEventListener('keydown', function (event) { if (event.key === 'Escape') closeMenu(); });
            document.querySelectorAll('.dn-menu a').forEach(function (link) { link.addEventListener('click', closeMenu); });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
