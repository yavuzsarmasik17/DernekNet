@model IEnumerable<DernekNet.Models.AfadHaber>
@{
    ViewData["Title"] = "AFAD Haberleri";
    Layout = "~/Areas/DernekAdmin/Views/Shared/_DernekAdminLayout.cshtml";
}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="h4 mb-0">AFAD Haberleri</h2>
    <a asp-action="Ekle" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Yeni Haber</a>
</div>
@if (TempData["Mesaj"] != null)
{
     <div class="alert alert-success">@TempData["Mesaj"]</div>
}
<div class="dn-card table-responsive">
    <table class="table table-hover align-middle">
        <thead><tr><th>Başlık</th><th>Yayın Tarihi (UTC)</th><th>Durum</th><th>İşlemler</th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Baslik</td>
                    <td>@item.YayinTarihi.ToString("dd.MM.yyyy HH:mm")</td>

                    <td><span class="badge @(item.AktifMi ? "bg-success" : "bg-secondary")">@(item.AktifMi ? "Yayında" : "Pasif")</span></td>
                    <td>
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-action="Duzenle" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                            <form asp-action="DurumDegistir" asp-route-id="@item.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@(item.AktifMi ? "Yayından Kaldır" : "Yayına Al")</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <p class="text-muted mb-0">Henüz kayıt bulunmuyor.</p>
    }
</div>
