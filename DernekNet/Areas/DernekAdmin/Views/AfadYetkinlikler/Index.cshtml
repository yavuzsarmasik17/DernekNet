@model IEnumerable<DernekNet.Models.AfadYetkinlik>

@{
    ViewData["Title"] = "AFAD Yetkinlikler";
    Layout = "~/Areas/DernekAdmin/Views/Shared/_DernekAdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 mb-1">AFAD Yetkinlik Yönetimi</h2>
        <div class="text-muted">
            Gönüllülerin sahip olabileceği yetkinlikleri tanımlayın.
        </div>
    </div>
    <a asp-action="Gonulluler" class="btn btn-outline-primary">
        <i class="bi bi-people me-1"></i>
        Gönüllü Yetkinlikleri
    </a>
</div>

@if (TempData["AfadYetkinlikMesaj"] != null)
{
    <div class="alert alert-success">
        @TempData["AfadYetkinlikMesaj"]
    </div>
}

@if (TempData["AfadYetkinlikHata"] != null)
{
    <div class="alert alert-danger">
        @TempData["AfadYetkinlikHata"]
    </div>
}

<div class="dn-card mb-4">
    <h3>Yeni Yetkinlik Tanımla</h3>

    <form asp-action="Olustur" method="post" class="row g-3">
        @Html.AntiForgeryToken()

        <div class="col-md-5">
            <label for="ad" class="form-label">Yetkinlik Adı</label>
            <input id="ad" name="ad"
                   class="form-control"
                   maxlength="150"
                   placeholder="Örn: İlk Yardım"
                   required />
        </div>

        <div class="col-md-5">
            <label for="aciklama" class="form-label">Açıklama</label>
            <input id="aciklama" name="aciklama"
                   class="form-control"
                   placeholder="Yetkinlik hakkında açıklama" />
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-plus-circle me-1"></i>
                Ekle
            </button>
        </div>
    </form>
</div>

<div class="dn-card">
    <h3>Tanımlı Yetkinlikler</h3>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Yetkinlik</th>
                    <th>Açıklama</th>
                    <th>Atanan Gönüllü</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var y in Model)
                {
                    <tr>
                        <td><strong>@y.Ad</strong></td>
                        <td>@(y.Aciklama ?? "—")</td>
                        <td>
                            <span class="badge bg-primary">
                                @y.Gonulluler.Count
                            </span>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                            Henüz yetkinlik tanımlanmadı.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
