@model IEnumerable<DernekNet.Models.AfadEgitim>

@{
    ViewData["Title"] = "AFAD Eğitimler";
    Layout = "~/Areas/DernekAdmin/Views/Shared/_DernekAdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">AFAD Eğitim Yönetimi</h2>
        <div class="text-muted">Eğitimleri ve gönüllü katılımlarını yönetin.</div>
    </div>
    <a asp-action="Olustur" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Yeni Eğitim
    </a>
</div>

@if (TempData["AfadEgitimMesaj"] != null)
{
    <div class="alert alert-success">@TempData["AfadEgitimMesaj"]</div>
}

<div class="dn-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Eğitim</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th>Atanan</th>
                    <th>Katılan</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>
                            <strong>@e.Baslik</strong>
                            @if (!string.IsNullOrWhiteSpace(e.Aciklama))
                            {
                                <div class="text-muted small">@e.Aciklama</div>
                            }
                        </td>
                        <td>@e.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (e.AktifMi)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>
                        <td>@e.Katilimlar.Count</td>
                        <td>@e.Katilimlar.Count(x => x.KatildiMi)</td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="Katilimlar"
                                   asp-route-id="@e.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Katılımlar
                                </a>
                                <a asp-action="Duzenle"
                                   asp-route-id="@e.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Düzenle
                                </a>
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            Henüz eğitim oluşturulmadı.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
