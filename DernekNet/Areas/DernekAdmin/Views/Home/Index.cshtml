@model DernekNet.Models.Dernek

@{
    Layout = "~/Areas/DernekAdmin/Views/Shared/_DernekAdminLayout.cshtml";
    ViewData["Title"] = "Dernek Yönetim Paneli";

    int duyuruSayisi = ViewBag.DuyuruSayisi ?? 0;
    int etkinlikSayisi = ViewBag.EtkinlikSayisi ?? 0;
}

<div class="mb-4">
    <h1 class="fw-bold">@Model.DernekAdi</h1>
    <p class="text-muted">
        Derneğinizin yönetim paneline hoş geldiniz.
    </p>
</div>

<div class="row g-4 mb-4">

    <div class="col-md-6">
        <div class="dn-card">
            <h3>Toplam Duyuru</h3>
            <div class="dn-number">@duyuruSayisi</div>
            <p class="text-muted mb-0">
                Derneğinize ait duyuru kayıtları
            </p>
        </div>
    </div>

    <div class="col-md-6">
        <div class="dn-card">
            <h3>Toplam Etkinlik</h3>
            <div class="dn-number">@etkinlikSayisi</div>
            <p class="text-muted mb-0">
                Derneğinize ait etkinlik kayıtları
            </p>
        </div>
    </div>

</div>

<div class="dn-card">
    <h3 class="text-dark fw-bold mb-3">
        Dernek Bilgileri
    </h3>

    <p><strong>Dernek:</strong> @Model.DernekAdi</p>
    <p><strong>Telefon:</strong> @Model.Telefon</p>
    <p><strong>E-posta:</strong> @Model.Email</p>
    <p><strong>Adres:</strong> @Model.Adres</p>

    <a asp-area=""
       asp-controller="Dernek"
       asp-action="Index"
       asp-route-id="@Model.Id"
       target="_blank"
       rel="noopener noreferrer"
       class="btn btn-primary mt-2">
        Dernek Web Sitesini Görüntüle
    </a>
</div>
