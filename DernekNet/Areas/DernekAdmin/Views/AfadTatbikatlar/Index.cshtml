@model IEnumerable<DernekNet.Models.AfadTatbikat>

@{
    ViewData["Title"] = "AFAD Tatbikatlar";
    Layout = "~/Areas/DernekAdmin/Views/Shared/_DernekAdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 mb-1">AFAD Tatbikat Yönetimi</h2>
        <div class="text-muted">
            Tatbikatları ve gönüllü katılımlarını yönetin.
        </div>
    </div>

    <a asp-action="Olustur" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>
        Yeni Tatbikat
    </a>
</div>

@if (TempData["AfadTatbikatMesaj"] != null)
{
    <div class="alert alert-success">
        @TempData["AfadTatbikatMesaj"]
    </div>
}

<div class="dn-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Tatbikat</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th>Atanan</th>
                    <th>Katılan</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>
                            <strong>@t.Baslik</strong>

                            @if (!string.IsNullOrWhiteSpace(t.Aciklama))
                            {
                                <div class="text-muted small">
                                    @t.Aciklama
                                </div>
                            }
                        </td>

                        <td>
                            @t.Tarih.ToString("dd.MM.yyyy HH:mm")
                        </td>

                        <td>
                            @if (t.AktifMi)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>

                        <td>@t.Katilimlar.Count</td>

                        <td>
                            @t.Katilimlar.Count(x => x.KatildiMi)
                        </td>

                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="Katilimlar"
                                   asp-route-id="@t.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Katılımlar
                                </a>

                                <a asp-action="Duzenle"
                                   asp-route-id="@t.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Düzenle
                                </a>
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6"
                            class="text-center text-muted py-4">
                            Henüz tatbikat oluşturulmadı.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
