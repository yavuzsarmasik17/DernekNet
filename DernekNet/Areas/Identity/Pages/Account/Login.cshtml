@page
@model DernekNet.Areas.Identity.Pages.Account.LoginModel
@{
    Layout = null;
    bool dernekGirisi = Model.DernekId.HasValue;
    string baslik = dernekGirisi ? (Model.DernekAdi ?? "Dernek Yönetimi") : "DERNEKNET";
    string aciklama = dernekGirisi
        ? (string.IsNullOrWhiteSpace(Model.DernekAciklama)
            ? "Derneğinizin çalışmalarını güvenle ve kolayca yönetin."
            : Model.DernekAciklama!)
        : "Platformdaki derneklerin yönetimini tek noktadan takip edin.";
    // Dernek tablosunda kurumsal renk alanı olmadığı için şimdilik sabit modern palet.
    ViewData["Title"] = dernekGirisi ? $"{baslik} | Yönetici Girişi" : "Platform Yönetici Girişi";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --ink: #162c36;
            --muted: #667a80;
            --accent: #087d78;
            --accent-dark: #075d59;
            --soft: #f3f8f7;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Segoe UI",Arial,sans-serif;
            background: #f5f8f8;
            color: var(--ink);
        }

        .page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: minmax(0,1.05fr) minmax(0,.95fr);
        }

        .identity {
            position: relative;
            overflow: hidden;
            background: linear-gradient(145deg,#12363d 0%,#0b6866 64%,#15948a 100%);
            color: #fff;
            padding: 55px clamp(28px,5vw,85px);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .identity::before {
                content: "";
                position: absolute;
                width: 430px;
                height: 430px;
                border: 1px solid rgba(255,255,255,.13);
                border-radius: 50%;
                right: -185px;
                bottom: -180px;
                box-shadow: 0 0 0 75px rgba(255,255,255,.035),0 0 0 150px rgba(255,255,255,.025);
                pointer-events: none;
            }

            .identity > * {
                position: relative;
                z-index: 1;
            }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            color: #fff;
            font-size: 20px;
            font-weight: 800;
            letter-spacing: .3px;
            text-decoration: none;
        }

        .brand-mark {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            background: rgba(255,255,255,.15);
            border: 1px solid rgba(255,255,255,.22);
            border-radius: 12px;
        }

        .identity-content {
            max-width: 580px;
            padding: 55px 0;
            animation: rise .65s ease both;
        }

        .logo {
            width: 94px;
            height: 94px;
            border-radius: 24px;
            background: #fff;
            padding: 10px;
            object-fit: contain;
            margin-bottom: 28px;
            box-shadow: 0 16px 45px rgba(0,0,0,.16);
        }

        .logo-placeholder {
            width: 94px;
            height: 94px;
            border-radius: 24px;
            background: rgba(255,255,255,.14);
            border: 1px solid rgba(255,255,255,.22);
            display: grid;
            place-items: center;
            font-size: 43px;
            margin-bottom: 28px;
        }

        .eyebrow {
            display: inline-block;
            padding: 8px 13px;
            border-radius: 99px;
            background: rgba(255,255,255,.14);
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .identity h1 {
            font-size: clamp(32px,4.1vw,57px);
            font-weight: 800;
            letter-spacing: -1.5px;
            line-height: 1.12;
            margin: 0 0 22px;
            overflow-wrap: anywhere;
        }

        .identity p {
            color: #d9f3ef;
            font-size: 17px;
            line-height: 1.8;
            max-width: 510px;
        }

        .identity-footer {
            font-size: 13px;
            color: #c6e6e2;
        }

        .right {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 28px;
        }

        .form-card {
            width: 100%;
            max-width: 460px;
            animation: rise .75s .08s ease both;
        }

        .form-badge {
            display: inline-flex;
            gap: 8px;
            align-items: center;
            border-radius: 99px;
            background: #e0f3ef;
            color: #086e65;
            padding: 9px 14px;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 23px;
        }

        .form-card h2 {
            font-size: clamp(29px,3vw,39px);
            font-weight: 800;
            letter-spacing: -.8px;
            margin: 0 0 10px;
        }

        .subtitle {
            color: var(--muted);
            line-height: 1.7;
            margin-bottom: 32px;
        }

        .form-label {
            font-weight: 650;
            margin-bottom: 9px;
        }

        .form-control {
            min-height: 54px;
            padding: 13px 15px;
            border: 1px solid #d3dfdf;
            border-radius: 13px;
            background: #fff;
        }

            .form-control:focus {
                border-color: #0b9188;
                box-shadow: 0 0 0 4px rgba(11,145,136,.12);
            }

        .password-wrap {
            position: relative;
        }

            .password-wrap .form-control {
                padding-right: 83px;
            }

        .toggle-password {
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            border: 0;
            background: none;
            color: #087d78;
            font-weight: 700;
            padding: 7px;
        }

        .form-check-input:checked {
            background-color: #087d78;
            border-color: #087d78;
        }

        .submit-btn {
            width: 100%;
            padding: 16px 18px;
            border: 0;
            border-radius: 13px;
            background: #087d78;
            color: #fff;
            font-weight: 750;
            transition: transform .2s,background .2s,box-shadow .2s;
        }

            .submit-btn:hover {
                background: #075d59;
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(8,125,120,.18);
            }

        .back {
            display: block;
            margin-top: 28px;
            text-align: center;
            text-decoration: none;
            color: #637982;
        }

            .back:hover {
                color: #087d78;
            }

        @@keyframes rise {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width:850px) {
            .page {
                grid-template-columns: 1fr;
            }

            .identity {
                min-height: 350px;
                padding: 28px;
                gap: 30px;
            }

            .identity-content {
                padding: 10px 0;
            }

            .identity h1 {
                font-size: 34px;
            }

            .identity p {
                font-size: 15px;
            }

            .right {
                padding: 45px 22px 65px;
            }
        }

        @@media (prefers-reduced-motion:reduce) {
            *, *::before, *::after {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>
</head>
<body>
    <main class="page">
        <section class="identity" aria-label="Dernek kimliği">
            <a class="brand" href="/"><span class="brand-mark">✦</span> DERNEKNET</a>
            <div class="identity-content">
                @if (dernekGirisi && !string.IsNullOrWhiteSpace(Model.DernekLogoUrl))
                {
                    <img class="logo" src="@Model.DernekLogoUrl" alt="@baslik logosu" />
                }
                else
                {
                    <div class="logo-placeholder" aria-hidden="true">@(dernekGirisi ? "🏛️" : "✦")</div>
                }
                <div><span class="eyebrow">@(dernekGirisi ? "Derneğe Özel Yönetici Girişi" : "Platform Yönetimi")</span></div>
                <h1>@baslik</h1>
                <p>@aciklama</p>
            </div>
            <div class="identity-footer">© @DateTime.Now.Year DERNEKNET · Güvenli yönetim altyapısı</div>
        </section>
        <section class="right">
            <div class="form-card">
                <div class="form-badge">🔒 @(dernekGirisi ? "Dernek Yöneticisi" : "Platform Admin")</div>
                <h2>Hoş Geldiniz</h2>
                <p class="subtitle">@(dernekGirisi ? "Yalnızca bu derneğin yetkili yöneticileri giriş yapabilir." : "Yalnızca platform yöneticileri giriş yapabilir.")</p>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="DernekId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <div class="mb-4">
                        <label asp-for="Input.Email" class="form-label">E-posta Adresi</label>
                        <input asp-for="Input.Email" class="form-control" type="email" autocomplete="username" placeholder="ornek@dernek.com" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Input.Password" class="form-label">Şifre</label>
                        <div class="password-wrap">
                            <input asp-for="Input.Password" id="sifre" class="form-control" type="password" autocomplete="current-password" placeholder="Şifrenizi girin" />
                            <button type="button" class="toggle-password" id="sifreButon" aria-label="Şifreyi göster" aria-pressed="false">Göster</button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Beni Hatırla</label>
                    </div>
                    <button type="submit" class="submit-btn">@(dernekGirisi ? "Dernek Yönetimine Giriş" : "Platform Yönetimine Giriş") →</button>
                </form>
                <a class="back" href="/">← Ana Sayfaya Dön</a>
            </div>
        </section>
    </main>
    <script>
        const sifre = document.getElementById('sifre');
        const sifreButon = document.getElementById('sifreButon');
        sifreButon.addEventListener('click', function () {
            const goster = sifre.type === 'password';
            sifre.type = goster ? 'text' : 'password';
            sifreButon.textContent = goster ? 'Gizle' : 'Göster';
            sifreButon.setAttribute('aria-pressed', String(goster));
        });
    </script>
</body>
</html>
