@model IEnumerable<DernekNet.Models.Etkinlik>

@{
    Layout = "~/Areas/PlatformAdmin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Etkinlik Yönetimi";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title">Etkinlik Yönetimi</h1>
        <p class="page-subtitle mb-0">
            Derneklere ait toplantı, eğitim ve organizasyonları yönetin.
        </p>
    </div>

    <a asp-area="PlatformAdmin"
       asp-controller="Etkinlikler"
       asp-action="Create"
       class="btn btn-primary">
        + Yeni Etkinlik Ekle
    </a>
</div>

@if (TempData["Basarili"] != null)
{
    <div class="alert alert-success">
        @TempData["Basarili"]
    </div>
}

<div class="admin-card">
    <div class="admin-card-header">
        Kayıtlı Etkinlikler (@Model.Count())
    </div>

    <div class="admin-card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>ETKİNLİK</th>
                        <th>DERNEK</th>
                        <th>TARİH</th>
                        <th>KONUM</th>
                        <th>DURUM</th>
                        <th>İŞLEMLER</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var etkinlik in Model)
                    {
                        <tr>
                            <td>
                                <strong>@etkinlik.EtkinlikAdi</strong>
                            </td>

                            <td>
                                @(etkinlik.Dernek?.DernekAdi ?? "-")
                            </td>

                            <td>
                                @etkinlik.EtkinlikTarihi.ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(etkinlik.Konum)
                                    ? "-"
                                    : etkinlik.Konum)
                            </td>

                            <td>
                                @if (etkinlik.AktifMi)
                                {
                                    <span class="badge bg-success">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Pasif
                                    </span>
                                }
                            </td>

                            <td>
                                <a asp-area="PlatformAdmin"
                                   asp-controller="Etkinlikler"
                                   asp-action="Edit"
                                   asp-route-id="@etkinlik.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Düzenle
                                </a>
                            </td>
                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted py-5">
                                Henüz etkinlik eklenmemiş.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
