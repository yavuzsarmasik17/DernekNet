@model DernekNet.Models.Dernek

@{
    Layout = "~/Areas/PlatformAdmin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dernek Düzenle";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title">Dernek Düzenle</h1>
        <p class="page-subtitle">
            Dernek bilgilerini ve logosunu yönetin.
        </p>
    </div>

    <a asp-area="PlatformAdmin"
       asp-controller="Dernekler"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Geri Dön
    </a>
</div>

<form asp-area="PlatformAdmin"
      asp-controller="Dernekler"
      asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="All"
         class="text-danger mb-3"></div>

    <div class="admin-card mb-4">
        <div class="admin-card-header">
            Dernek Bilgileri
        </div>

        <div class="admin-card-body">
            <div class="row g-4">

                <div class="col-12">
                    <label asp-for="DernekAdi"
                           class="form-label">
                        Dernek Adı *
                    </label>

                    <input asp-for="DernekAdi"
                           class="form-control"
                           required />

                    <span asp-validation-for="DernekAdi"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Telefon"
                           class="form-label">
                        Telefon
                    </label>

                    <input asp-for="Telefon"
                           class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Email"
                           class="form-label">
                        E-posta
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control" />
                </div>

                <div class="col-12">
                    <label asp-for="Adres"
                           class="form-label">
                        Adres
                    </label>

                    <textarea asp-for="Adres"
                              class="form-control"
                              rows="3"></textarea>
                </div>

                <div class="col-12">
                    <label asp-for="Aciklama"
                           class="form-label">
                        Hakkımızda / Dernek Açıklaması
                    </label>

                    <textarea asp-for="Aciklama"
                              class="form-control"
                              rows="6"></textarea>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="AktifMi"
                               class="form-check-input" />

                        <label asp-for="AktifMi"
                               class="form-check-label">
                            Dernek Aktif
                        </label>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- LOGO YÖNETİMİ -->
    <div class="admin-card mb-4">
        <div class="admin-card-header">
            Dernek Logosu
        </div>

        <div class="admin-card-body">

            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
            {
                <div class="mb-4">
                    <label class="form-label">
                        Mevcut Logo
                    </label>

                    <div class="border rounded p-3 bg-light"
                         style="max-width:240px;">

                        <img src="@Model.LogoUrl"
                             alt="Dernek Logosu"
                             style="width:100%;
                                    max-height:180px;
                                    object-fit:contain;" />
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    Bu dernek için henüz logo yüklenmemiş.
                </div>
            }

            <div class="mb-3">
                <label for="logoDosyasi"
                       class="form-label">
                    Yeni Logo Yükle
                </label>

                <input type="file"
                       id="logoDosyasi"
                       name="logoDosyasi"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                <span class="text-danger small">
                    @Html.ValidationMessage("logoDosyasi")
                </span>

                <div class="form-text">
                    JPG, PNG veya WEBP formatı.
                    En fazla 2 MB.
                </div>
            </div>

            <div id="logoOnizlemeAlani"
                 class="mt-3"
                 style="display:none;">

                <label class="form-label">
                    Yeni Logo Önizleme
                </label>

                <div class="border rounded p-3"
                     style="max-width:240px;">

                    <img id="logoOnizleme"
                         alt="Yeni Logo Önizleme"
                         style="width:100%;
                                max-height:180px;
                                object-fit:contain;" />
                </div>
            </div>

        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap mb-5">

        <button type="submit"
                class="btn btn-primary px-4">
            Değişiklikleri Kaydet
        </button>

        <a asp-area=""
           asp-controller="Dernek"
           asp-action="Index"
           asp-route-id="@Model.Id"
           target="_blank"
           class="btn btn-outline-primary px-4">
            Web Sitesini Görüntüle
        </a>

    </div>
</form>

<script>
    document.getElementById("logoDosyasi")
        .addEventListener("change", function () {

            const dosya = this.files[0];
            const alan = document.getElementById("logoOnizlemeAlani");
            const resim = document.getElementById("logoOnizleme");

            if (!dosya) {
                alan.style.display = "none";
                resim.removeAttribute("src");
                return;
            }

            const izinliTipler = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            if (!izinliTipler.includes(dosya.type)) {
                alert("Yalnızca JPG, PNG veya WEBP seçebilirsiniz.");
                this.value = "";
                alan.style.display = "none";
                return;
            }

            if (dosya.size > 2 * 1024 * 1024) {
                alert("Logo en fazla 2 MB olabilir.");
                this.value = "";
                alan.style.display = "none";
                return;
            }

            const okuyucu = new FileReader();

            okuyucu.onload = function (e) {
                resim.src = e.target.result;
                alan.style.display = "block";
            };

            okuyucu.readAsDataURL(dosya);
        });
</script>
